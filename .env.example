# Copy to .env and fill in. Every external tool is optional: leave a setting empty to switch its feature off.

# Admin key for the management pages and the /mcp HTTP endpoint (required to add sources)
ADMIN_KEY=

# Data directory. Files are the source of truth; index.sqlite3 can be deleted and rebuilt with `fk rebuild`.
FK_DATA_DIR=~/media-archive
FK_PORT=8090
FK_SITE_NAME=fk ai slop

# ---- network ----
# HTTP proxy for YouTube, RSS, articles and the LLM API
# FK_PROXY=http://127.0.0.1:7890
# Platforms that skip the proxy (default: bilibili,xiaohongshu)
# FK_DIRECT_PLATFORMS=bilibili,xiaohongshu
# Bind direct connections to IPv4, for hosts with a broken IPv6 route
# FK_FORCE_IPV4=1

# ---- media tools (found on PATH by default) ----
# FK_YTDLP=/usr/local/bin/yt-dlp
# FK_FFMPEG=/usr/bin/ffmpeg
# FK_NODE=/usr/bin/node
# Browser whose YouTube login yt-dlp borrows (needed for members-only videos and to avoid bot checks)
# FK_YOUTUBE_COOKIES_BROWSER=firefox
# Subtitle languages to request. YouTube keeps Chinese speech ahead of English and
# drops tracks that are only a translation (same default as config.py).
# FK_YOUTUBE_SUB_LANGS=zh,zh-Hans,zh-Hant,zh-CN,zh-TW,zh-HK,yue,zh-Hans-orig,zh-Hant-orig,zh-CN-orig,zh-TW-orig,zh-HK-orig,zh-orig,yue-orig,en-orig,en,en-US
# FK_BILIBILI_SUB_LANGS=ai-zh,zh-Hans,zh-CN,zh,zh-Hant,en
# Netscape cookie file for Bilibili (AI subtitles and the space API work better logged in)
# FK_BILIBILI_COOKIES=~/.config/fk-ai-slop/bilibili-cookies.txt

# ---- AI summaries: any OpenAI-compatible chat completions API ----
# FK_LLM_BASE_URL=https://api.deepseek.com/v1
# FK_LLM_API_KEY=
# FK_LLM_MODEL=deepseek-chat
# Extra JSON merged into each request, e.g. for GLM: {"thinking": {"type": "disabled"}}
# FK_LLM_EXTRA_BODY=

# ---- speech recognition for videos and podcasts without subtitles ----
# Python of a venv with funasr + torch (SenseVoiceSmall); see docs
# FK_ASR_PYTHON=~/.local/opt/asr-venv/bin/python
# FK_ASR_DEVICE=cuda:0
# FK_ASR_BATCH=2
# Optional CPU-only venv used when the GPU run fails
# FK_ASR_CPU_PYTHON=

# ---- semantic search (Ollama). Set FK_EMBED_MODEL= (empty) to use keyword search only ----
# FK_OLLAMA_URL=http://127.0.0.1:11434
# FK_EMBED_MODEL=qwen3-embedding:0.6b
# FK_EMBED_DIM=1024

# ---- Xiaohongshu: needs the xiaohongshu-mcp container (deploy/xiaohongshu-mcp) ----
# FK_XHS_MCP_URL=http://127.0.0.1:18060
# Login cookies of that container, used to scroll profiles when backfilling
# FK_XHS_COOKIES=~/.local/share/xiaohongshu-mcp/data/cookies.json

# How many posts a new source backfills at most
# FK_BACKFILL=1000
